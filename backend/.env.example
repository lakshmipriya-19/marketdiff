# Everything here has a working default. Copy to .env only if you need to change something.

# SQLite by default — no setup required. Point this at Postgres for deployment:
#   DATABASE_URL=postgresql+psycopg://marketdiff:marketdiff@localhost:5432/marketdiff
DATABASE_URL=sqlite:///./marketdiff.db

# auto  — try live market data, fall back to demo data and label it (default)
# yahoo — live only
# demo  — deterministic generated data, useful for demos and offline work
MARKETDIFF_PROVIDER=auto

MARKETDIFF_PROVIDER_TIMEOUT=4.0
MARKETDIFF_QUOTE_TTL=45
MARKETDIFF_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Freshness thresholds, in seconds.
MARKETDIFF_LIVE_MAX_AGE=180
MARKETDIFF_RECENT_MAX_AGE=1800
